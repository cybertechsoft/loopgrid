# LoopGrid v0.8 Design Partner Release
# Recommended: do not hand-edit secrets. Run:
#   python scripts/generate_pilot_env.py
# The generated .env is ignored by Git.

LOOPGRID_POSTGRES_PASSWORD=
LOOPGRID_PLATFORM_ADMIN_KEY=
LOOPGRID_BOOTSTRAP_TOKEN=
LOOPGRID_PAYLOAD_MASTER_KEY_B64=

LOOPGRID_ENV=production
LOOPGRID_PUBLIC_BASE_URL=http://localhost:8000
LOOPGRID_REQUIRE_USER_AUTH=true
LOOPGRID_STRICT_PRODUCTION_SAFETY=true
LOOPGRID_CORS_ORIGINS=
LOOPGRID_ENFORCE_LIFECYCLE=true

LOOPGRID_SIGNER_PROVIDER=local_ed25519
LOOPGRID_TSA_URL=
LOOPGRID_TSA_CA_FILE=
LOOPGRID_MCP_UPSTREAMS_JSON={}

LOOPGRID_DB_POOL_SIZE=10
LOOPGRID_DB_MAX_OVERFLOW=20
LOOPGRID_DB_POOL_RECYCLE_SECONDS=1800
LOOPGRID_MAX_REQUEST_BODY_BYTES=2000000
LOOPGRID_INGEST_RATE_LIMIT_PER_MINUTE=600
LOOPGRID_ADMIN_RATE_LIMIT_PER_MINUTE=120
